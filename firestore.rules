rules_version = '2';

// Règles de sécurité Cloud Firestore : à copier dans la console Firebase
// (Firestore Database → onglet « Règles » → Publier).
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque utilisateur ne peut lire et modifier que ses propres données :
    // son profil users/{uid} et ses favoris users/{uid}/favorites/...
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
